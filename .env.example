# Server lokal default: HOST=127.0.0.1. Gunakan 0.0.0.0 di Docker/hosting.
HOST=127.0.0.1
PORT=8000
JALANYUK_DB=data/jalanyuk.db
# Ganti alamat kontak untuk penggunaan layanan OSM publik (jangan pakai email contoh):
JALANYUK_USER_AGENT=JalanYuk/2.5 (kontak: hubungi-admin-di-domain-anda)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass.private.coffee/api/interpreter
OSRM_URL=https://router.project-osrm.org

# Tidak memakai Google Routes API atau Google API key.

# Opsional: untuk pembanding estimasi waktu selain OSRM
OPENROUTESERVICE_API_KEY=
